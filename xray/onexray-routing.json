{
  "name": "Россия: Direct + VPN",
  "outbounds": [
    {}
  ],
  "geodata": {
    "assets": [
      {
        "file": "friends-proxy-geosite.dat",
        "url": "https://raw.githubusercontent.com/VladislavMikhailov1995/shadowrocket_config/files/xray_config/friends-proxy-geosite.dat"
      },
      {
        "file": "friends-proxy-geoip.dat",
        "url": "https://raw.githubusercontent.com/VladislavMikhailov1995/shadowrocket_config/files/xray_config/friends-proxy-geoip.dat"
      }
    ]
  },
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "ruleTag": "VPN: проверка публичного IP",
        "domain": [
          "full:ipwhois.app",
          "full:ipwho.is",
          "full:api.ip.sb",
          "full:ipapi.co",
          "full:ipinfo.io"
        ],
        "balancerTag": "proxy"
      },
      {
        "ruleTag": "VPN: домены из общего списка",
        "domain": [
          "ext:friends-proxy-geosite.dat:PROXY"
        ],
        "balancerTag": "proxy"
      },
      {
        "ruleTag": "VPN: IP-подсети из общего списка",
        "ip": [
          "ext:friends-proxy-geoip.dat:PROXY"
        ],
        "balancerTag": "proxy"
      },
      {
        "ruleTag": "Direct: всё остальное",
        "ip": [
          "0.0.0.0/0",
          "::/0"
        ],
        "outboundTag": "direct"
      }
    ]
  }
}
